{
  // Served at admin.georgesheppard.dev. The whole hostname must sit behind a Cloudflare Access
  // application; the API independently verifies the Access token this Worker forwards.
  "name": "mise-admin",
  "compatibility_date": "2026-06-28",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.georgesheppard.dev", "custom_domain": true }],
  "vars": {
    "API_ORIGIN": "https://api.georgesheppard.dev"
  },
  "assets": {
    "directory": "../dist-admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
